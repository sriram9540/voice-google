# VOCALIS DESKTOP VOICE STUDIO ENVIRONMENT CONFIGURATION
# Note: Vocalis is strictly local-first and does not require proprietary credentials.
# All provider configurations can be set through the UI or pre-configured below.

# Direct API endpoint configuration (optional default):
# VITE_DIRECT_API_BASE_URL="https://api.openai.com/v1"

# Local model inference server (optional default):
# VITE_LOCAL_INFERENCE_ENDPOINT="http://localhost:8080/v1"

# GEMINI_API_KEY: Optional server-side capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
